    {
        "id": "a1b2c3d4e5f60110",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "rozdělit hodnoty",
        "func": "// Z jedné zprávy {t, h, p, a} udělá 4 samostatné zprávy,\n// každou pro jeden výstup (teplota, vlhkost, tlak, výška).\nconst d = msg.payload;\nreturn [\n    { topic: \"Teplota\", payload: d.t },\n    { topic: \"Vlhkost\", payload: d.h },\n    { topic: \"Tlak\",    payload: d.p },\n    { topic: \"Výška\",   payload: d.a }\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 160,
        "wires": [
            ["a1b2c3d4e5f60200", "a1b2c3d4e5f60300"],
            ["a1b2c3d4e5f60201", "a1b2c3d4e5f60301"],
            ["a1b2c3d4e5f60202", "a1b2c3d4e5f60302"],
            ["a1b2c3d4e5f60210"]
        ]
    },
